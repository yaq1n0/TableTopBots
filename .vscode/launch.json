{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite"],
      "cwd": "${workspaceFolder}/ui",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Launch TableTopBots",
      "configurations": ["API Server", "Vite Dev Server"]
    }
  ]
}
